# Copia este archivo como .env.local (desarrollo) y configura las mismas
# variables en Vercel (Project Settings > Environment Variables) para producción.
# .env.local NO se sube a git: ahí viven las claves.

# ---------------------------------------------------------------------------
# Supabase  (Project Settings > API Keys; la URL en Data API)
# ---------------------------------------------------------------------------
# URL del proyecto, SIN /rest/v1 al final. Ej.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (sb_publishable_...). Solo lee lo que las reglas de seguridad permiten.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). Acceso total: nunca la compartas ni la uses en el navegador.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# Dominio público con https, sin "/" final. Ej.: https://kaffalove.cl
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Mercado Pago  (Tus integraciones > tu aplicación > Credenciales de producción)
# ---------------------------------------------------------------------------
# Access Token (APP_USR-...). Mientras esté vacío, en desarrollo se usa un pago simulado.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones).
# URL a configurar allá: https://<tu-dominio>/api/webhooks/mercadopago  · Evento: Pagos
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Correos (opcional, recomendado)  https://resend.com
# ---------------------------------------------------------------------------
# Confirmación de pedido, aviso de despacho/retiro, recuperar contraseña y bienvenida.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend. Ej.: Kaffa Love <pedidos@kaffalove.cl>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Tareas y APIs internas
# ---------------------------------------------------------------------------
# Secreto para la tarea que libera reservas vencidas (Vercel lo envía solo).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Clave para la API de solo lectura de agentes (/api/v1/...). Vacía = API deshabilitada.
AGENT_API_KEY=

# ---------------------------------------------------------------------------
# Facturas de compra (Admin → Compras)
# ---------------------------------------------------------------------------
# Clave de la API de Claude (https://console.anthropic.com > API Keys) para leer las facturas.
ANTHROPIC_API_KEY=
# Cuenta de servicio de Google con la API de Drive activada: pega aquí el contenido
# COMPLETO del archivo JSON de su clave (en una sola línea).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Enlace o id de la carpeta de Drive con las facturas. Compártela con el correo de la
# cuenta de servicio (client_email del JSON) como Lector.
DRIVE_FACTURAS_FOLDER=

# Solo para pruebas en un entorno de staging sin Mercado Pago. NUNCA en producción.
# ALLOW_SIMULATED_PAYMENTS=true

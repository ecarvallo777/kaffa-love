# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a git: ahí viven las claves.
#
# Dónde encontrarlos en Supabase: Project Settings > API Keys (y Data API para la URL)

# URL del proyecto, p. ej. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (empieza con sb_publishable_). Solo permite lo que las reglas de seguridad dejan leer.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (empieza con sb_secret_). Acceso total: nunca la compartas ni la uses en el navegador.
SUPABASE_SECRET_KEY=
